10 REM SKETCH: DRAW WITH THE JOYSTICK. FIRE CHANGES COLOUR
20 CLS 0
30 x = 160: y = 120: c = 255
40 x = x + JOY(0): y = y + JOY(1)
50 IF x < 0 THEN x = 0
60 IF x > 319 THEN x = 319
70 IF y < 0 THEN y = 0
80 IF y > 239 THEN y = 239
90 IF JOY(2) THEN c = INT(RND(1) * 255) + 1
100 PSET x, y, c
110 VSYNC
120 IF INKEY$ = "" THEN 40
130 TEXT
