10 REM CATCH: CATCH THE FALLING STARS IN THE BASKET
20 RANDOMIZE
30 CLS 0: score = 0: lives = 3: bx = 140
40 REM ---- A NEW STAR
50 sx = INT(RND(1) * 300) + 10: sy = 12
60 speed = 2 + score / 5
70 FRECT 0, 0, 320, 10, 0
80 GPRINT 4, 2, "SCORE" + STR$(score), 255
90 GPRINT 250, 2, "LIVES" + STR$(lives), 255
100 REM ---- ONE FRAME: MOVE THE BASKET, THEN THE STAR
110 FRECT bx, 224, 40, 8, 0
120 p = PADDLE(0)
130 IF p >= 0 THEN bx = p * 1.1 ELSE bx = bx + JOY(0) * 5
140 IF bx < 0 THEN bx = 0
150 IF bx > 280 THEN bx = 280
160 FRECT bx, 224, 40, 8, RGB(0, 200, 255)
170 FCIRCLE sx, sy, 4, 0
180 sy = sy + speed
190 IF sy >= 222 THEN 220
200 FCIRCLE sx, sy, 4, RGB(255, 255, 0)
210 VSYNC: GOTO 110
220 REM ---- THE STAR HAS LANDED
230 IF sx < bx OR sx > bx + 40 THEN 250
240 score = score + 1: SOUND 880, 60: GOTO 40
250 lives = lives - 1: SOUND 110, 300
260 IF lives > 0 THEN 40
270 FRECT 250, 0, 70, 10, 0: GPRINT 250, 2, "LIVES 0", 255
280 GPRINT 124, 110, "GAME OVER", RGB(255, 0, 0)
290 GPRINT 104, 124, "YOU CAUGHT" + STR$(score), 255
300 IF PLAYING(0) THEN 300
